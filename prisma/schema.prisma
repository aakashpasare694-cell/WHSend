datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Channel {
  id             String   @id
  name           String
  apiKeyHash     String
  status         String   @default("NOT_CONNECTED") // NOT_CONNECTED, WAITING_FOR_QR, CONNECTING, CONNECTED, DISCONNECTED
  whatsappNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  messages       Message[]
}

model Message {
  id         String   @id @default(uuid())
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  recipient  String
  content    String
  status     String   // SENT, FAILED
  whatsappId String?
  error      String?
  createdAt  DateTime @default(now())
}
