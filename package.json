{
  "name": "whsend-gateway",
  "version": "1.0.0",
  "description": "WHSend - WhatsApp Web Session Gateway & Messaging Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,emerald\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "vite",
    "build": "prisma generate && tsc && vite build",
    "start": "node --import tsx/esm src/server.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "studio": "prisma studio"
  },
  "keywords": [
    "whsend",
    "whatsapp",
    "gateway",
    "baileys",
    "express",
    "react",
    "socket.io"
  ],
  "author": "WHSend Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@whiskeysockets/baileys": "^6.7.19",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "lucide-react": "^0.475.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
